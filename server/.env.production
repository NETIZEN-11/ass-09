# Production Environment Variables
# Replace these with your actual production values

# MongoDB Atlas Connection (sign up at mongodb.com/cloud/atlas)
MONGODB_URI=your_mongodb_atlas_connection_string

# JWT Secret (generate a strong random string)
JWT_SECRET=your_super_secret_jwt_key_min_32_characters

# JWT Expiry
JWT_EXPIRE=7d

# Server Port (Render will set this automatically)
PORT=5000

# Frontend URL (after deploying to Netlify)
CLIENT_URL=https://your-app-name.netlify.app

# Email Configuration (if using email features)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@visitorpass.com

# File Upload Settings
MAX_FILE_SIZE=5242880

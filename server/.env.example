# Environment Variables Example
# Copy this file to .env and update with your actual values

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=5000

# ============================================
# MONGODB CONFIGURATION
# ============================================
# Local: mongodb://localhost:27017/visitor-pass-db
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/visitor-pass-db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/visitor-pass-db

# ============================================
# JWT CONFIGURATION
# ============================================
# Generate secure string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_EXPIRE=7d

# ============================================
# EMAIL CONFIGURATION (Nodemailer)
# ============================================
# Gmail Setup:
# 1. Enable 2-Factor Authentication: https://myaccount.google.com/security
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Use 16-digit app password (remove spaces)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_16_digit_app_password
EMAIL_FROM=VisitorPass System <noreply@visitorpass.com>
EMAIL_SECURE=false

# ============================================
# TWILIO CONFIGURATION (Optional - SMS)
# ============================================
# Sign up: https://www.twilio.com/try-twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_ENABLED=false

# ============================================
# APPLICATION URLS
# ============================================
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# ============================================
# FILE UPLOAD CONFIGURATION
# ============================================
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads
ALLOWED_FILE_TYPES=image/jpeg,image/jpg,image/png,application/pdf

# ============================================
# ORGANIZATION CONFIGURATION
# ============================================
DEFAULT_ORG_NAME=Demo Organization
DEFAULT_ORG_ID=demo-org-001

# ============================================
# SECURITY CONFIGURATION
# ============================================
SESSION_TIMEOUT=86400000
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION=30

# ============================================
# PASS CONFIGURATION
# ============================================
DEFAULT_PASS_VALIDITY=24
QR_CODE_SIZE=200
AUTO_APPROVE_APPOINTMENTS=false

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log

# ============================================
# BACKUP
# ============================================
ENABLE_AUTO_BACKUP=false
BACKUP_INTERVAL_HOURS=24
BACKUP_PATH=./backups

# ============================================
# NOTIFICATIONS
# ============================================
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=false
NOTIFY_ON_VISITOR_ARRIVAL=true
NOTIFY_ON_APPOINTMENT_APPROVAL=true
NOTIFY_ON_PASS_GENERATION=true

# ============================================
# ADMIN SETTINGS
# ============================================
ADMIN_EMAIL=admin@visitorpass.com
ADMIN_PHONE=+919876543210
SUPPORT_EMAIL=support@visitorpass.com

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_QR_SCANNER=true
ENABLE_FACIAL_RECOGNITION=false
ENABLE_VISITOR_PHOTOS=true
ENABLE_VEHICLE_TRACKING=false
ENABLE_REPORTS=true
ENABLE_ANALYTICS=true

# ============================================
# DATABASE BACKUP
# ============================================
DB_BACKUP_ENABLED=false
DB_BACKUP_SCHEDULE=0 2 * * *

# ============================================
# TIMEZONE
# ============================================
TZ=Asia/Kolkata
